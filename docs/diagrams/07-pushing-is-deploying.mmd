    classDef good fill:#E4EDE4,stroke:#3F7A46,stroke-width:2px,color:#261B22
    classDef warn fill:#F3EBD8,stroke:#8A6A18,stroke-width:2px,color:#261B22
    class F act
    class EX gate
    class WEB bad
    class GIT good
    class STILL,ONCE warn
