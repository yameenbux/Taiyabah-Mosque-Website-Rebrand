+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="robots" content="noindex, nofollow">
+<link rel="icon" href="/favicon.ico" sizes="any">
+<link rel="apple-touch-icon" href="/apple-touch-icon.png">
+<title>Pupil &mdash; Madrasah &mdash; Taiyabah Masjid</title>
+<!-- ===========================================================
+     THIS SCREEN IS TWO FOLDERS DOWN, so every shared asset is reached with
+     ../../ and the rail's own script with ../. Getting this wrong does not
+     error - the page loads with no styling and no rail, which reads as a
+     broken deploy rather than a broken path.
+     =========================================================== -->
+<link rel="preload" href="../../fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>
+<link rel="preload" href="../../fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
+<link rel="stylesheet" href="../../admin/fonts.css">
+<link rel="stylesheet" href="../../admin/shell.css">
+<script src="../../admin/shell.js" defer></script>
+<script src="../nav.js" defer></script>
+<link rel="stylesheet" href="../../admin/screen.css">
+<link rel="stylesheet" href="pupil.css">
+</head>
+<body>
+
+<div class="shell">
+  <div class="brand">
+    <div class="brand-inner">
+      <img class="logo" src="data:image/png;base64," alt="Taiyabah Masjid">
+      <div class="eyebrow">Taiyabah Masjid</div>
+      <h1>Pupil</h1>
+      <p>Everything on file for one child. Opening this page is written down against your name, because who has read a child's record is a question a subject access request asks.</p>
+      <!-- Back to the madrasah, not to the Admin Centre. This screen is inside
+           the portal, and somebody who came from /portal/ expects one press to
+           put them back where they started. The rail carries the longer way
+           out. One dot-dot: this page is /portal/staff/. -->
+      <a class="back" href="../pupils/">&larr; Back to the roll</a>
+    </div>
+
+    <p class="pcredit">Designed &amp; built by <a href="https://ysbdesigns.uk" target="_blank" rel="noopener">YSB Designs</a></p>
+  </div>
+
+  <div class="panel">
+
+    <!-- loading -->
+    <div class="card" id="view-loading">
+      <div class="loading">
+        <div class="spinner" role="status" aria-label="Checking your session"></div>
+        <p>Checking your session&hellip;</p>
+      </div>
+    </div>
+
+    <!-- sign in -->
+    <div class="card" id="view-signin" hidden>
+      <h2>Sign in</h2>
+      <p class="sub">Use the email address the masjid office holds for you.</p>
+      <div class="err" id="signin-error" hidden></div>
+      <form id="signin-form" novalidate>
+        <div class="field">
+          <label for="signin-email">Email address</label>
+          <input type="email" id="signin-email" autocomplete="username" required placeholder="you@example.com">
+        </div>
+        <div class="field">
+          <label for="signin-password">Password</label>
+          <div class="pw">
+            <input type="password" id="signin-password" autocomplete="current-password" required placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;">
+            <button type="button" id="pw-toggle" aria-label="Show password">Show</button>
+          </div>
+        </div>
+        <button type="submit" class="btn btn-gold" id="signin-submit">Sign in</button>
+      </form>
+      <p class="note">Accounts are issued by the masjid office. If you can't get in, ring 01204 535 997.</p>
+    </div>
+
+    <!-- two-step: verify -->
+    <div class="card" id="view-mfa" hidden>
+      <h2>Two-step verification</h2>
+      <p class="sub">Enter the 6-digit code from your authenticator app.</p>
+      <div class="err" id="mfa-error" hidden></div>
+      <form id="mfa-form" novalidate>
+        <div class="field">
+          <label for="mfa-code">Verification code</label>
+          <input type="text" id="mfa-code" class="code-input" inputmode="numeric"
+                 autocomplete="one-time-code" placeholder="000000" required>
+        </div>
+        <button type="submit" class="btn btn-gold" id="mfa-submit">Verify</button>
+      </form>
+      <p class="note">Codes refresh every 30 seconds. If yours keeps failing, check your phone's clock is set automatically.</p>
+    </div>
+
+    <!-- two-step: enrol -->
+    <div class="card" id="view-enrol" hidden>
+      <h2>Set up two-step verification</h2>
+      <p class="sub">This screen holds staff records and contact details, so it needs a second factor before you can continue.</p>
+      <div class="err" id="enrol-error" hidden></div>
+
+      <ul class="steps">
+        <li>Install an authenticator app &mdash; Google Authenticator, Microsoft Authenticator or Authy.</li>
+        <li>Scan the square below with it.</li>
+        <li>Enter the 6-digit code it shows you.</li>
+      </ul>
+
+      <div class="qr">
+        <img id="enrol-qr" alt="QR code for setting up two-step verification">
+        <div class="secret" id="enrol-secret"></div>
+      </div>
+      <p class="sub">Can't scan it? Type the code above into your app by hand.</p>
+
+      <form id="enrol-form" novalidate>
+        <div class="field">
+          <label for="enrol-code">Code from your app</label>
+          <input type="text" id="enrol-code" class="code-input" inputmode="numeric"
+                 autocomplete="one-time-code" placeholder="000000" required>
+        </div>
+        <button type="submit" class="btn btn-gold" id="enrol-submit">Confirm and finish setup</button>
+      </form>
+      <p class="note">Keep the app installed &mdash; you'll need it every time you sign in.</p>
+    </div>
+
+    <!-- signed in -->
+    <div class="card" id="view-app" hidden>
+      <div class="who">
+        <div class="who-t">
+          <strong id="app-name">&mdash;</strong>
+          <span id="app-email">&mdash;</span>
+        </div>
+      </div>
+
+      <div class="roles" id="app-roles"></div>
+
+      <div class="err" id="app-error" hidden></div>
+
+      <div class="err" id="app-noaccess" hidden>
+        This account cannot open the madrasah portal. If that is wrong, ask a
+        masjid administrator to check what you have been given on the access
+        screen in the Admin Centre.
+      </div>
+
+      
+            <section class="bk" id="pp-panel-bk" hidden>
+
+        <div class="pp-top">
+          <a class="pp-back" href="../pupils/">&larr; All pupils</a>
+          <div class="pp-acts" id="pp-acts">
+            <button class="btn btn-ghost" id="pp-edit" type="button">Amend these details</button>
+          </div>
+        </div>
+
+        <div class="err" id="pp-error" hidden></div>
+
+        <div id="pp-body" hidden>
+          <div class="pp-head" id="pp-head"></div>
+
+          <!-- ABOVE THE TABS AND OUTSIDE THEM. An allergy is safety
+               information and a teacher needs it the moment the page opens,
+               not two clicks in. -->
+          <div class="pp-med" id="pp-med" hidden></div>
+
+          <div class="pp-tabs" id="pp-tabs" role="tablist"></div>
+          <div class="pp-panel" id="pp-panel" role="tabpanel"></div>
+
+          <div class="pp-form" id="pp-editor" hidden></div>
+        </div>
+      </section>
+
+
+
+      <button type="button" class="btn btn-ghost" id="app-signout">Sign out</button>
+    </div>
+
+  </div>
+</div>
+
+<script src="../../admin/supabase.js"></script>
+<script src="config.js"></script>
+<script>
+  document.getElementById('pw-toggle').addEventListener('click', function(){
+    var i = document.getElementById('signin-password');
+    var showing = i.type === 'text';
+    i.type = showing ? 'password' : 'text';
+    this.textContent = showing ? 'Show' : 'Hide';
+    this.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
+  });
+</script>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/portal/pupil/pupil.css b/portal/pupil/pupil.css
new file mode 100644
index 0000000..6e9c105
--- /dev/null
+++ b/portal/pupil/pupil.css
@@ -0,0 +1,95 @@
+/* ===========================================================================
+   ONE PUPIL
+
+   The furniture — tokens, buttons, fields, the sign-in panel — is in
+   admin/screen.css, linked before this. This sheet is only the record.
+
+   [hidden] FIRST, ALWAYS. An attribute selector beats a plain class, so a
+   rule like `.pp-med { display:block }` would defeat `hidden` and put a
+   child's medical note on screen for a pupil who has none. Every stylesheet
+   in this portal opens with this line for that reason.
+   =========================================================================== */
+[hidden] { display:none !important; }
+
+.pp-top       { display:flex; justify-content:space-between; align-items:center;
+                gap:12px; flex-wrap:wrap; margin:0 0 18px; }
+.pp-back      { color:var(--muted); text-decoration:none; font-size:14px; }
+.pp-back:hover{ color:var(--ink); text-decoration:underline; }
+.pp-acts      { display:flex; gap:10px; flex-wrap:wrap; }
+.pp-acts .btn { width:auto; flex:0 0 auto; }
+
+.pp-head h2   { margin:0 0 4px; }
+.pp-sub       { margin:0 0 18px; color:var(--muted); font-size:14px; }
+.pp-q         { color:var(--muted); font-size:13px; }
+.pp-warn      { color:var(--danger-ink); font-size:14px; margin:6px 0; }
+
+/*  READ BEFORE THIS CHILD IS LEFT WITH ANYBODY.
+    Outside the tabs and above them, so it is on screen whichever tab is
+    open. A teacher needs an allergy the moment the page loads, not two
+    clicks in — which is why this is the one thing on the page that is not
+    behind a tab.                                                            */
+.pp-med       { border:2px solid var(--danger); border-radius:12px;
+                padding:14px 16px; margin:0 0 20px;
+                background:color-mix(in srgb, var(--danger) 6%, var(--card)); }
+.pp-med h5    { margin:0 0 8px; font-size:13px; letter-spacing:.06em;
+                text-transform:uppercase; color:var(--danger-ink); }
+.pp-med p     { margin:4px 0; font-size:15px; }
+
+/*  THE TABS. */
+.pp-tabs      { display:flex; gap:4px; flex-wrap:wrap; margin:0 0 -1px;
+                border-bottom:1px solid var(--line); }
+.pp-tab       { font:inherit; font-size:14px; padding:10px 14px; border:0;
+                border-bottom:2px solid transparent; background:none;
+                color:var(--muted); cursor:pointer; }
+.pp-tab:hover { color:var(--ink); }
+.pp-tab.is-on { color:var(--ink); font-weight:700;
+                border-bottom-color:var(--gold-ink); }
+.pp-tab:focus-visible { outline:2px solid var(--gold-ink); outline-offset:-2px; }
+
+.pp-panel     { padding:20px 0 4px; }
+.pp-panel h4  { margin:18px 0 8px; font-size:15px; }
+.pp-panel h4:first-child { margin-top:0; }
+
+.pp-grid      { display:grid; grid-template-columns:minmax(150px,auto) 1fr;
+                gap:8px 20px; margin:0; font-size:15px; }
+.pp-grid dt   { color:var(--muted); font-size:13px; }
+.pp-grid dd   { margin:0; }
+
+.pp-list      { margin:0; padding-left:18px; }
+.pp-list li   { margin:4px 0; }
+
+.pp-guardian  { border:1px solid var(--line); border-radius:10px;
+                padding:10px 12px; margin:0 0 8px; }
+.pp-guardian a{ color:var(--gold-ink); }
+.pp-pill      { display:inline-block; font-size:11px; letter-spacing:.05em;
+                text-transform:uppercase; padding:2px 7px; border-radius:99px;
+                background:var(--line); color:var(--ink); }
+
+/*  A brother or sister is a LINK, not a button — a middle-click should open
+    them in a tab like anything else on the internet.                        */
+.pp-mini      { display:inline-block; padding:5px 10px; margin:0 6px 6px 0;
+                border:1px solid var(--line); border-radius:99px;
+                font-size:14px; color:var(--ink); text-decoration:none; }
+.pp-mini:hover{ border-color:var(--gold-ink); color:var(--gold-ink); }
+
+/*  THE AMEND FORM. */
+.pp-form      { margin:24px 0 0; padding:20px 0 0; border-top:1px solid var(--line); }
+.pp-form h4   { margin:0 0 4px; }
+.pp-fld       { margin:0 0 12px; }
+.pp-fld label { display:block; font-size:13px; color:var(--muted); margin:0 0 4px; }
+.pp-fld input, .pp-fld textarea, .pp-fld select { width:100%; }
+.pp-fld textarea { min-height:70px; }
+.pp-form-acts { display:flex; gap:10px; flex-wrap:wrap; margin:16px 0 0; }
+.pp-form-acts .btn { width:auto; flex:0 0 auto; }
+
+@media (min-width: 760px) {
+  .pp-form    { display:grid; grid-template-columns:1fr 1fr; gap:0 20px; }
+  .pp-form h4, .pp-form .pp-sub, .pp-form-acts { grid-column:1 / -1; }
+}
+
+@media (max-width: 720px) {
+  .pp-tabs    { overflow-x:auto; flex-wrap:nowrap; scroll-snap-type:x mandatory; }
+  .pp-tab     { flex:0 0 auto; scroll-snap-align:start; }
+  .pp-grid    { grid-template-columns:1fr; gap:2px 0; }
+  .pp-grid dd { margin:0 0 10px; }
+}
