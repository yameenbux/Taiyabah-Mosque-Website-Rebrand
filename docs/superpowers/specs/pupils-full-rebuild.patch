 portal/pupils/app.js         | 47 ++++++++++++++++++++++++++++++++++++
 portal/pupils/index.html     |  7 ++++--
 portal/pupils/pupils.css     | 15 ++++++++++++
 tools/build_pupils_screen.py |  7 ++++--
 tools/pupils_module.js       | 47 ++++++++++++++++++++++++++++++++++++
 6 files changed, 166 insertions(+), 4 deletions(-)

